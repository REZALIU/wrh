                document.getElementById("message").innerHTML = "Error occurred" + (msg ? (": " + msg) : ".");
            }
        }
    };

    var visitor_gray_callback = function (response) {
        if (response["retcode"] === 20000000) {
            var tid = response["data"]["tid"];
            Store.DB.set('tid', tid);

            var alt = response["data"]["alt"];
            if (alt !== "") {
                var url = "https://m.weibo.cn/api/container/getIndex?containerid=containerid%3D106003type%253D25%2526t%253D3%2526disable_hot%253D1%2526filter_type%253Drealtimehot%26title%3D%E5%BE%AE%E5%8D%9A%E7%83%AD%E6%90%9C%26show_cache_when_error%3D1%26extparam%3Dseat%253D1%2526mi_cid%253D100103%2526c_type%253D30%2526pos%253D0_0%2526cate%253D10103%2526region_relas_conf%253D0%2526dgr%253D0%2526filter_type%253Drealtimehot%2526lcate%253D1001%2526display_time%253D1747276576%2526pre_seqid%253D1747276576619023133119%26luicode%3D20000174";
                requrl = (url === "none") ? "" : "&url=" + encodeURIComponent(url);
                var params = "entry=sso&source=visitor_restore&type=3&alt=" + encodeURIComponent(alt) + requrl;
                window.location.replace("https://passport.weibo.com/sso/v2/login?" + params);
            } else {
                cross_domain2(response)
            }
        }
    };

    var isInIframe = function () {
        try {
            return window.self !== window.top;
        } catch (e) {
            return true;
        }
    };

</script>
